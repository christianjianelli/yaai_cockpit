<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout"
	xmlns:u="sap.ui.unified">
	<Dialog
		id="_IDAddToTransportDialog"
		title="{i18n>addToTransport}"
		class="sapUiContentPadding">
		<content>
			<l:VerticalLayout id="_IDAddToTransportVerticalLayout">
				<Label 
					id="_IDAddToTransportLabelTransportRequest" 
					labelFor="_IDAddToTransportInputTransportRequest" 
					text="{i18n>transportRequest}">
				</Label>
				<Input
					id="_IDAddToTransportInputTransportRequest"
					type="Text"
					width="20em"
					maxLength="30"
					editable="true">
				</Input>
			</l:VerticalLayout>
		</content>
		<buttons>        
            <Button id="_IDAddToTransportButtonAdd" press=".onAddToTransport" text="{i18n>add}"/>
			<Button id="_IDAddToTransportButtonCancel" press=".onCloseDialogAddToTransport" text="{i18n>cancel}"/>
        </buttons>
	</Dialog>
</core:FragmentDefinition>